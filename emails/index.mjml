<mjml>
  <mj-head>
    <mj-title>Your Investigation is Complete - ThreddIQ</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text color="#111827" font-size="16px" line-height="1.6" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      .brand-dot { color: #ff4500; } .id-font { font-family: 'SFMono-Regular',
      Consolas, 'Liberation Mono', Menlo, monospace; } .premium-card { border:
      1px solid #e5e7eb; border-radius: 12px; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f9fafb">
    <!-- Header Section -->
    <mj-section background-color="#0a0a0a" padding="32px 24px">
      <mj-column>
        <mj-text
          font-size="22px"
          font-weight="900"
          letter-spacing="-0.03em"
          color="#ffffff"
          padding="0"
        >
          ThreddIQ<span class="brand-dot">.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content Section -->
    <mj-section padding="40px 24px 0">
      <mj-column background-color="#ffffff" padding="40px" border-radius="16px" border="1px solid #f1f1f1">
        <mj-text
          font-size="28px"
          font-weight="800"
          color="#0a0a0a"
          padding-bottom="16px"
          letter-spacing="-0.02em"
          line-height="1.2"
        >
          Your analysis is complete.
        </mj-text>

        <mj-text color="#4b5563" font-size="17px" padding-bottom="32px">
          We've finished mining Reddit for
          <strong style="color: #0a0a0a">"{{ keyword }}"</strong>. Our AI has
          identified high-signal pain points and clustered them into actionable
          market opportunities.
        </mj-text>

        <mj-button
          href="https://threddiq.com/dashboard/reports/{{runId}}"
          background-color="#ff4500"
          color="#ffffff"
          border-radius="10px"
          font-weight="800"
          font-size="16px"
          padding="18px 32px"
          inner-padding="0"
          align="left"
        >
          View Full Report →
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Details Grid -->
    <mj-section padding="24px 24px 48px">
      <mj-column border="1px dashed #e2e8f0" border-radius="12px" padding="20px">
        <mj-text
          font-size="11px"
          color="#94a3b8"
          font-weight="800"
          letter-spacing="0.1em"
          padding-bottom="8px"
          text-transform="uppercase"
        >
          Search Term
        </mj-text>
        <mj-text
          font-size="15px"
          font-weight="700"
          color="#0a0a0a"
          padding-top="0"
        >
          {{ keyword }}
        </mj-text>
      </mj-column>

      <mj-column width="4%" padding="0"></mj-column>

      <mj-column border="1px dashed #e2e8f0" border-radius="12px" padding="20px">
        <mj-text
          font-size="11px"
          color="#94a3b8"
          font-weight="800"
          letter-spacing="0.1em"
          padding-bottom="8px"
          text-transform="uppercase"
        >
          Investigation ID
        </mj-text>
        <mj-text
          font-size="14px"
          font-weight="600"
          color="#ff4500"
          padding-top="0"
          css-class="id-font"
        >
          #{{ runId }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="0 24px 60px">
      <mj-column border-top="1px solid #e2e8f0" padding-top="32px">
        <mj-text font-size="13px" color="#94a3b8" padding-bottom="12px">
          You received this because you started a market investigation on
          ThreddIQ.
        </mj-text>

        <mj-text font-size="13px" color="#94a3b8" padding-top="0">
          © 2026 ThreddIQ. All rights reserved.<br />
          <mj-raw>
            <div style="margin-top: 12px;">
              <a
                href="https://threddiq.com/dashboard/settings"
                style="color: #ff4500; text-decoration: none; font-weight: 600;"
                >Settings</a
              >
              <span style="color: #cbd5e1; margin: 0 8px;">&bull;</span>
              <a
                href="https://threddiq.com/privacy"
                style="color: #ff4500; text-decoration: none; font-weight: 600;"
                >Privacy Policy</a
              >
            </div>
          </mj-raw>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
