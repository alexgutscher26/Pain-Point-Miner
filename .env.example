# ═══════════════════════════════════════════════════════════════
# Pain Point Miner — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Type annotations:  (string) | (number) | (boolean) | (json)
# = means default value if unset.
# ═══════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
#   (string)  Required. PostgreSQL connection string.
#
BETTER_AUTH_SECRET=
#   (string)  Required. Secret key for Better Auth session encryption.
#             Generate via: openssl rand -hex 32
#
BETTER_AUTH_URL=http://localhost:3000
#   (string)  = "http://localhost:3000". Base URL of the auth server.
#
NEXT_PUBLIC_APP_URL=http://localhost:3000
#   (string)  Public-facing URL of the app (used for emails, redirects).
#
CRON_SECRET=replace-with-long-random-secret
#   (string)  = "". Shared secret for authenticating cron job requests.
#             Protects /api/cron/* routes from unauthorized invocation.
#
VERCEL_PROJECT_PRODUCTION_URL=
#   (string)  = "". Vercel project production URL (auto-set in Vercel deployments).
#
VERCEL_URL=
#   (string)  = "". Vercel deployment URL (auto-set by Vercel).

# ── Better Auth ───────────────────────────────────────────────
BETTER_AUTH_API_URL=
#   (string)  = "". API URL for Better Auth Sentinel (fraud detection).
#             Set to enable Sentinel. Must be a valid URL starting with http(s)://.
#
BETTER_AUTH_KV_URL=
#   (string)  = "". KV store URL for Sentinel session/rate-limit storage.
#
BETTER_AUTH_API_KEY=
#   (string)  = "". API key for Sentinel.
#
USERNAME_PLUGIN_ENABLED=true
#   (boolean) = "true". Enable username-based sign-in (in addition to email).
#
NEXT_PUBLIC_BETTER_AUTH_API_URL=
#   (string)  = "". Client-side Sentinel API URL (mirrors BETTER_AUTH_API_URL).
#
NEXT_PUBLIC_BETTER_AUTH_API_KEY=
#   (string)  = "". Client-side Sentinel API key.

# ── Billing / Feature Gating ──────────────────────────────────
DEFAULT_BILLING_PLAN=starter
#   (string)  = "starter". Default plan for users without a subscription.
#             Values: starter | growth | pro | founder | professional
#
BILLING_PLAN_OVERRIDES_JSON={}
#   (json)    = "{}". Per-user plan overrides, e.g. {"user123":"pro"}
#
LOCAL_TRIAL_ENABLED=true
#   (boolean) = "true". Enable trial period for new users.
#
LOCAL_TRIAL_DAYS=3
#   (number)  = 3. Trial duration in days.
#
REQUIRE_PAID_PLAN_AFTER_TRIAL=true
#   (boolean) = "true". Block access to paid features after trial ends.

# ── Stripe ────────────────────────────────────────────────────
STRIPE_PLUGIN_ENABLED=false
#   (boolean) = "false". Enable Stripe billing integration.
#             When true, STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are required.
#
STRIPE_SUBSCRIPTION_ENABLED=false
#   (boolean) = "false". Enable subscription-based billing (Better Auth Stripe plugin).
#             Requires STRIPE_PRICE_GROWTH_MONTHLY and STRIPE_PRICE_PRO_MONTHLY.
#
STRIPE_SECRET_KEY=
#   (string)  Required if STRIPE_PLUGIN_ENABLED=true. Stripe API secret key.
#
STRIPE_WEBHOOK_SECRET=
#   (string)  Required if STRIPE_PLUGIN_ENABLED=true. Stripe webhook signing secret.
#
# Stripe Price IDs — set the ones relevant to your billing model:
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
# LTD (Lifetime Deal) price IDs:
STRIPE_PRICE_LTD_FOUNDER=
STRIPE_PRICE_LTD_PROFESSIONAL=
STRIPE_PRICE_LTD_UPGRADE=
# Credit top-up price IDs (tier-specific):
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_250=
STRIPE_PRICE_CREDITS_1000=
STRIPE_PRICE_CREDITS_50_FOUNDER=
STRIPE_PRICE_CREDITS_250_FOUNDER=
STRIPE_PRICE_CREDITS_1000_FOUNDER=
STRIPE_PRICE_CREDITS_50_PRO=
STRIPE_PRICE_CREDITS_250_PRO=
STRIPE_PRICE_CREDITS_1000_PRO=

# ── AI (OpenRouter) ───────────────────────────────────────────
OPENROUTER_API_KEY=
#   (string)  Required. OpenRouter API key for LLM-based extraction and embeddings.
#
OPENROUTER_BASE_URL=https://openrouter.ai
#   (string)  = "https://openrouter.ai". Base URL for the OpenRouter API.
#             Override to route through a proxy or self-hosted gateway,
#             e.g. http://localhost:8080 for local testing.
#
MAX_CONCURRENT_AI_EXTRACTIONS=5
#   (number)  = 5. Max parallel AI extraction/embedding calls per mining run.
#             Higher values increase throughput but may hit rate limits.
#
PGVECTOR_COSINE_THRESHOLD=0.82
#   (number)  = 0.82. Cosine similarity threshold for cluster assignment (0-1).
#             Higher = stricter matching; lower = more aggressive clustering.
#
EMBEDDING_BATCH_SIZE=10
#   (number)  = 10. Number of texts to embed in a single API call.
#             Reserved for future batch-embedding support.

# ── Reddit API ────────────────────────────────────────────────
REDDIT_CLIENT_ID=
#   (string)  Required for Reddit API access. Reddit app client ID.
#
REDDIT_CLIENT_SECRET=
#   (string)  Required. Reddit app client secret.
#
REDDIT_USER_AGENT=rpp/1.0 (by u/your_reddit_username)
#   (string)  Required. Reddit API user agent string.
#             Follow Reddit's API guidelines: identify your app.
#
REDDIT_WEBHOOK_SECRET=
#   (string)  = "". Secret for authenticating external RSS-to-webhook requests.

# ── Scheduler Tuning ──────────────────────────────────────────
SCHEDULED_BATCH_LIMIT=5
#   (number)  = 5. Max scrapers to process in a single scheduled run.
#
SCHEDULED_MAX_POSTS_PER_SUBREDDIT=180
#   (number)  = 180. Max Reddit posts to fetch per subreddit per run.
#
SCHEDULED_MAX_SUBREDDITS=10
#   (number)  = 10. Max subreddits to query per scraper per run.
#
SCHEDULED_PROCESSING_LIMIT=8
#   (number)  = 8. Max posts to analyze per batch (after pre-filter).

# ── Email (Loops.so) ──────────────────────────────────────────
LOOPS_API_KEY=
#   (string)  = "". Loops.so API key for transactional emails.
#             If unset, email features are safely disabled.
#
LOOPS_WELCOME_TRANSACTIONAL_ID=
#   (string)  Loops transactional email ID for welcome emails.
#
LOOPS_REPORT_READY_TRANSACTIONAL_ID=
#   (string)  Loops transactional email ID for report-ready notifications.
#
LOOPS_WEEKLY_DIGEST_TRANSACTIONAL_ID=
#   (string)  Loops transactional email ID for weekly digests.
#
LOOPS_TRIAL_EXPIRING_ID=
#   (string)  Loops transactional email ID for trial-expiring reminders.
#
LOOPS_TRIAL_ENDED_ID=
#   (string)  Loops transactional email ID for trial-ended notifications.
#
LOOPS_TRIAL_WINBACK_ID=
#   (string)  Loops transactional email ID for trial winback campaigns.
#
LOOPS_RESET_PASSWORD_TRANSACTIONAL_ID=
#   (string)  Loops transactional email ID for password resets.

# ── Feature Flags ─────────────────────────────────────────────
FEATURE_FLAGS={}
#   (json)    = {}. Runtime feature toggles, e.g.:
#             {"newPipeline":true,"batchEmbedding":false}
#             See lib/feature-flags.ts for usage.

# ── Maintenance Mode ──────────────────────────────────────────
NEXT_PUBLIC_MAINTENANCE_MODE=false
#   (boolean)  = "false". When true, shows a maintenance page to all users.
#
NEXT_PUBLIC_MAINTENANCE_MESSAGE=
#   (string)   = "". Optional custom maintenance message shown to users.
